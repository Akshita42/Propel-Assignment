# ── Database ──────────────────────────────────────────────────────────────────
# Local dev uses SQLite; Docker/production uses Async PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./propel.db

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Paste your Gemini API key from Google AI Studio below:
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Fault Detection Tuning ────────────────────────────────────────────────────
HEARTBEAT_TIMEOUT_SECONDS=1080
FAULT_GROUPING_WINDOW_SECONDS=30
MIN_SPAN_CONFIDENCE=0.50
RESTORATION_THRESHOLD=0.80
