# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://propel:propel@db:5432/propeldb
DATABASE_URL_SYNC=postgresql+psycopg2://propel:propel@db:5432/propeldb

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Fault Detection Tuning ────────────────────────────────────────────────────
# Seconds of missed heartbeats before a pole is considered DARK
HEARTBEAT_TIMEOUT_SECONDS=1080
# Seconds to group simultaneous fault signals together
FAULT_GROUPING_WINDOW_SECONDS=30
# Minimum confidence for span-level localization (below → DT fallback)
MIN_SPAN_CONFIDENCE=0.50
# Percentage of affected poles restored before auto-verifying ticket
RESTORATION_THRESHOLD=0.80
